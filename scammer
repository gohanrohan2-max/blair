-- Helper untuk require ModuleScript secara aman tanpa resiko thread hang/yield
local function safeRequire(modInst, timeoutSec)
    timeoutSec = timeoutSec or 0.04
    if not modInst or not modInst:IsA("ModuleScript") then return false, nil end
    
    local name = modInst.Name:lower()
    -- Hanya require module yang berbau data/config/tabel statis
    local isDataLike = name:find("data") or name:find("config") or name:find("database") 
        or name:find("item") or name:find("drop") or name:find("shop") 
        or name:find("setting") or name:find("const") or name:find("tier") 
        or name:find("list") or name:find("info") or name:find("def")
        or name:find("stat") or name:find("price") or name:find("reward")
        
    -- Jangan require controller, service, runtime, UI script, knit, client yang mengeksekusi logika game
    if not isDataLike then return false, nil end
    if name:find("controller") or name:find("service") or name:find("runtime") or name:find("knit") or name:find("client") then
        return false, nil
    end

    local done = false
    local success = false
    local result = nil

    local thread = task.spawn(function()
        local ok, res = pcall(require, modInst)
        if not done then
            done = true
            success = ok
            result = res
        end
    end)

    -- Tunggu sebentar. Jika module melakukan yield (misal WaitForChild / task.wait), batalkan thread!
    local startWait = os.clock()
    while not done and (os.clock() - startWait) < timeoutSec do
        task.wait(0.01)
    end

    if not done then
        done = true
        pcall(task.cancel, thread)
        return false, nil
    end

    return success, result
end

function SysScanner.ScanGameData(onFoundCallback)
    local startTime = os.clock()
    local dataList = {}
    local seen = {}

    local function addEntry(category, source, name, valType, displayVal, rawVal, path, inst, isModule)
        local key = tostring(category) .. ":" .. tostring(name) .. ":" .. tostring(path)
        if seen[key] then return end
        seen[key] = true

        local entry = {
            Category = category,
            Source = source,
            Name = tostring(name),
            Type = tostring(valType),
            Value = tostring(displayVal),
            RawValue = rawVal,
            Path = path or "",
            Instance = inst,
            IsModule = isModule or false
        }
        table.insert(dataList, entry)
        if onFoundCallback then
            pcall(onFoundCallback, entry)
        end
    end

    -- ==============================================================================
    -- [1] DEEP SCAN: REPLICATEDSTORAGE (Database, Configs, Items, Values, Attributes)
    -- ==============================================================================
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local successRep, repDescendants = pcall(function() return ReplicatedStorage:GetDescendants() end)
    
    if successRep and repDescendants then
        local repCount = 0
        for _, inst in ipairs(repDescendants) do
            repCount = repCount + 1
            if repCount % 150 == 0 then task.wait() end

            local parentName = inst.Parent and inst.Parent.Name or "ReplicatedStorage"

            -- A. ValueBase Objects (IntValue, StringValue, NumberValue, BoolValue, ObjectValue, etc.)
            if inst:IsA("ValueBase") then
                addEntry("ReplicatedStorage", parentName, inst.Name, inst.ClassName, inst.Value, inst.Value, generateLuaPath(inst), inst)

            -- B. ModuleScripts (Database, Configs, DropRates, Item definitions, Formulas)
            elseif inst:IsA("ModuleScript") then
                local okMod, modTable = safeRequire(inst, 0.04)
                if okMod and type(modTable) == "table" then
                    local count = 0
                    local keysSample = {}
                    for k, _ in pairs(modTable) do
                        count = count + 1
                        if #keysSample < 5 then
                            table.insert(keysSample, tostring(k))
                        end
                    end
                    local summary = string.format("Table (%d entri: %s%s)", count, table.concat(keysSample, ", "), count > 5 and "..." or "")
                    addEntry("Modules", parentName .. " (Module)", inst.Name, "ModuleScript (Table)", summary, modTable, generateLuaPath(inst), inst, true)
                else
                    addEntry("ReplicatedStorage", parentName, inst.Name, "ModuleScript", "ModuleScript Instance", inst, generateLuaPath(inst), inst)
                end

            -- C. Attributes pada Folder, Configuration, Model, dsb di ReplicatedStorage
            elseif inst:IsA("Folder") or inst:IsA("Configuration") or inst:IsA("Model") then
                local attrs = inst:GetAttributes()
                local attrCount = 0
                for attrName, attrVal in pairs(attrs) do
                    attrCount = attrCount + 1
                    addEntry("ReplicatedStorage", parentName .. " (Attr)", attrName, typeof(attrVal), toLuaString(attrVal, 0), attrVal, generateLuaPath(inst) .. ':GetAttribute("' .. attrName .. '")', inst)
                end
                if inst:IsA("Configuration") and attrCount == 0 then
                    addEntry("ReplicatedStorage", parentName, inst.Name, "Configuration", "Config Folder", inst, generateLuaPath(inst), inst)
                end
            end
        end
    end

    -- ==============================================================================
    -- [2] DEEP SCAN: PLAYERSCRIPTS (Controllers, Client Tables, Attributes, Values)
    -- ==============================================================================
    if LocalPlayer then
        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
        if playerScripts then
            local successPs, psDescendants = pcall(function() return playerScripts:GetDescendants() end)
            if successPs and psDescendants then
                local psCount = 0
                for _, inst in ipairs(psDescendants) do
                    psCount = psCount + 1
                    if psCount % 150 == 0 then task.wait() end

                    local parentName = inst.Parent and inst.Parent.Name or "PlayerScripts"

                    -- A. ValueBase di PlayerScripts
                    if inst:IsA("ValueBase") then
                        addEntry("PlayerScripts", parentName, inst.Name, inst.ClassName, inst.Value, inst.Value, generateLuaPath(inst), inst)

                    -- B. ModuleScripts di PlayerScripts (Client Controller state / tables)
                    elseif inst:IsA("ModuleScript") then
                        local okMod, modTable = safeRequire(inst, 0.04)
                        if okMod and type(modTable) == "table" then
                            local count = 0
                            for _ in pairs(modTable) do count = count + 1 end
                            local summary = string.format("Client Table (%d entri)", count)
                            addEntry("PlayerScripts", parentName .. " (Module)", inst.Name, "ModuleScript (Table)", summary, modTable, generateLuaPath(inst), inst, true)
                        else
                            addEntry("PlayerScripts", parentName, inst.Name, "ModuleScript", "Client Controller", inst, generateLuaPath(inst), inst)
                        end

                    -- C. Attributes di PlayerScripts
                    elseif inst:IsA("Folder") or inst:IsA("Configuration") or inst:IsA("LocalScript") then
                        local attrs = inst:GetAttributes()
                        for attrName, attrVal in pairs(attrs) do
                            addEntry("PlayerScripts", parentName .. " (Attr)", attrName, typeof(attrVal), toLuaString(attrVal, 0), attrVal, generateLuaPath(inst) .. ':GetAttribute("' .. attrName .. '")', inst)
                        end
                    end
                end
            end
        end

        -- ==============================================================================
        -- [3] PLAYER PROFILE & LIVE REMOTES (Data profil & stats aktif)
        -- ==============================================================================
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        if leaderstats then
            for _, val in ipairs(leaderstats:GetChildren()) do
                if val:IsA("ValueBase") then
                    addEntry("Player", "leaderstats", val.Name, val.ClassName, val.Value, val.Value, generateLuaPath(val), val)
                end
            end
        end

        local playerAttrs = LocalPlayer:GetAttributes()
        for attrName, attrVal in pairs(playerAttrs) do
            addEntry("Player", "Player Attribute", attrName, typeof(attrVal), toLuaString(attrVal, 0), attrVal, 'game:GetService("Players").LocalPlayer:GetAttribute("' .. attrName .. '")', LocalPlayer)
        end

        pcall(function()
            local remoteFolder = ReplicatedStorage:FindFirstChild("Remote") or ReplicatedStorage:FindFirstChild("remotes") or ReplicatedStorage:FindFirstChild("Remotes")
            if remoteFolder then
                local profileFolder = remoteFolder:FindFirstChild("Profile") or remoteFolder:FindFirstChild("profile")
                if profileFolder then
                    local getDataRF = profileFolder:FindFirstChild("GetDataRF") or profileFolder:FindFirstChild("GetTotalDataRF")
                    if getDataRF and getDataRF:IsA("RemoteFunction") then
                        local ok, pData = pcall(function() return getDataRF:InvokeServer() end)
                        if ok and type(pData) == "table" then
                            for k, v in pairs(pData) do
                                local displayVal = (type(v) == "table") and "{...}" or tostring(v)
                                addEntry("Player", "Profile Remote (Live)", tostring(k), typeof(v), displayVal, v, generateLuaPath(getDataRF) .. ':InvokeServer()["' .. tostring(k) .. '"]', getDataRF, type(v) == "table")
                            end
                        end
                    end
                end
                local bpFolder = remoteFolder:FindFirstChild("Backpack") or remoteFolder:FindFirstChild("backpack")
                if bpFolder then
                    local getBpRF = bpFolder:FindFirstChild("GetBackpackInfoRF")
                    if getBpRF and getBpRF:IsA("RemoteFunction") then
                        local ok, bpData = pcall(function() return getBpRF:InvokeServer() end)
                        if ok and type(bpData) == "table" then
                            for k, v in pairs(bpData) do
                                local displayVal = (type(v) == "table") and "{...}" or tostring(v)
                                addEntry("Player", "Backpack Remote (Live)", tostring(k), typeof(v), displayVal, v, generateLuaPath(getBpRF) .. ':InvokeServer()["' .. tostring(k) .. '"]', getBpRF, type(v) == "table")
                            end
                        end
                    end
                end
            end
        end)
    end

    -- ==============================================================================
    -- [4] DEEP SCAN: WORKSPACE (Values, Attributes, Configs, Prompts, Interactables)
    -- ==============================================================================
    local Workspace = game:GetService("Workspace")
    local successWs, wsDescendants = pcall(function() return Workspace:GetDescendants() end)
    if successWs and wsDescendants then
        local wsCount = 0
        for _, inst in ipairs(wsDescendants) do
            -- Filter instan objek 3D fisik / visual berat agar FPS tetap mulus dan anti-freeze
            local cName = inst.ClassName
            if cName == "Part" or cName == "MeshPart" or cName == "Decal" or cName == "Texture" or cName == "SpecialMesh" 
                or cName == "Weld" or cName == "Motor6D" or cName == "Attachment" or cName == "ParticleEmitter" 
                or cName == "Sound" or cName == "Terrain" or cName == "Beam" or cName == "Trail" 
                or cName == "Highlight" or cName == "UnionOperation" or cName == "CornerWedgePart" or cName == "WedgePart"
                or cName == "TrussPart" or cName == "SurfaceGui" or cName == "BillboardGui" then
                
                -- Jika part memiliki atribut custom, tetap catat!
                local pAttrs = inst:GetAttributes()
                for aName, aVal in pairs(pAttrs) do
                    addEntry("Workspace", inst.Name .. " (Part Attr)", aName, typeof(aVal), toLuaString(aVal, 0), aVal, generateLuaPath(inst) .. ':GetAttribute("' .. aName .. '")', inst)
                end
                continue
            end

            wsCount = wsCount + 1
            if wsCount % 150 == 0 then task.wait() end

            local parentName = inst.Parent and inst.Parent.Name or "Workspace"

            -- A. ValueBase di Workspace (IntValue, StringValue, BoolValue, ObjectValue, dll.)
            if inst:IsA("ValueBase") then
                addEntry("Workspace", parentName, inst.Name, inst.ClassName, inst.Value, inst.Value, generateLuaPath(inst), inst)

            -- B. Interactive Objects (ProximityPrompt & ClickDetector)
            elseif inst:IsA("ProximityPrompt") then
                local promptSummary = string.format("Prompt: %s | Action: %s", tostring(inst.ObjectText), tostring(inst.ActionText))
                addEntry("Workspace", parentName .. " (Prompt)", inst.Name, "ProximityPrompt", promptSummary, inst, generateLuaPath(inst), inst)
            elseif inst:IsA("ClickDetector") then
                addEntry("Workspace", parentName .. " (Click)", inst.Name, "ClickDetector", "MaxDistance: " .. tostring(inst.MaxActivationDistance), inst, generateLuaPath(inst), inst)

            -- C. Models, Folders, Configurations yang memiliki Attributes
            elseif inst:IsA("Model") or inst:IsA("Folder") or inst:IsA("Configuration") then
                local attrs = inst:GetAttributes()
                for attrName, attrVal in pairs(attrs) do
                    addEntry("Workspace", parentName .. " (" .. inst.Name .. ")", attrName, typeof(attrVal), toLuaString(attrVal, 0), attrVal, generateLuaPath(inst) .. ':GetAttribute("' .. attrName .. '")', inst)
                end
                if inst:IsA("Configuration") then
                    addEntry("Workspace", parentName, inst.Name, "Configuration", "Config Folder", inst, generateLuaPath(inst), inst)
                end
            end
        end
    end

    table.sort(dataList, function(a, b)
        if a.Category == b.Category then
            return a.Name:lower() < b.Name:lower()
        end
        return a.Category < b.Category
    end)

    SysScanner.GameData = dataList
    local elapsedTime = math.floor((os.clock() - startTime) * 1000) / 1000
    print(string.format("[SysScanner] Pemindaian data selesai dalam %.3f detik. Ditemukan: %d data entri.", elapsedTime, #dataList))
    return dataList, elapsedTime
end

