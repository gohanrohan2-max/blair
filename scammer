    print(SysScanner.ExportToString(filterClass))
end

function SysScanner.Search(keyword)
    if not keyword or keyword == "" then return SysScanner.Remotes end
    keyword = keyword:lower()
    local matched = {}
    for _, r in ipairs(SysScanner.Remotes) do
        if r.Name:lower():find(keyword, 1, true) or r.FullName:lower():find(keyword, 1, true) then
            table.insert(matched, r)
        end
    end
    return matched
end

