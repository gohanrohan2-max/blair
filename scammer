local TARGET_CLASSES = {
    ["RemoteEvent"] = true,
    ["RemoteFunction"] = true,
    ["UnreliableRemoteEvent"] = true,
    ["BindableEvent"] = true,
    ["BindableFunction"] = true
}

local SERVICES_TO_SCAN = {
    "ReplicatedStorage",
    "Workspace",
    "Players",
    "Lighting",
    "ReplicatedFirst",
    "StarterGui",
    "StarterPack",
    "SoundService",
    "MaterialService",
    "Teams",
    "TextChatService"
}

function SysScanner.IsRemote(instance)
    if not instance or typeof(instance) ~= "Instance" then return false end
    return TARGET_CLASSES[instance.ClassName] == true
end

function SysScanner.FormatRemoteData(instance)
    local successPath, fullName = pcall(function() return instance:GetFullName() end)
    local luaPath = generateLuaPath(instance)
    
    return {
        Instance = instance,
        Name = instance.Name,
        ClassName = instance.ClassName,
        FullName = successPath and fullName or instance.Name,
        LuaPath = luaPath,
        Parent = instance.Parent and instance.Parent.Name or "Unknown",
        FoundAt = os.date("%X")
    }
end

function SysScanner.Scan(onFoundCallback)
    local startTime = os.clock()
    local scannedCount = 0
    local remotesList = {}
    local seen = {}

    local function checkAndAdd(inst)
        if not inst or seen[inst] then return end
        seen[inst] = true
        
        if SysScanner.IsRemote(inst) then
            local data = SysScanner.FormatRemoteData(inst)
            table.insert(remotesList, data)
            scannedCount = scannedCount + 1
            if onFoundCallback then
                pcall(onFoundCallback, data)
            end
        end
    end

    for _, serviceName in ipairs(SERVICES_TO_SCAN) do
        local ok, srv = pcall(function() return game:GetService(serviceName) end)
        if ok and srv then
            local successDescendants, descendants = pcall(function() return srv:GetDescendants() end)
            if successDescendants and descendants then
                for _, inst in ipairs(descendants) do
                    checkAndAdd(inst)
                end
            end
        end
    end

    local successGameChildren, gameChildren = pcall(function() return game:GetChildren() end)
    if successGameChildren and gameChildren then
        for _, child in ipairs(gameChildren) do
            local okDesc, descendants = pcall(function() return child:GetDescendants() end)
            if okDesc and descendants then
                for _, inst in ipairs(descendants) do
                    checkAndAdd(inst)
                end
            end
        end
    end

    table.sort(remotesList, function(a, b)
        if a.ClassName == b.ClassName then
            return a.Name:lower() < b.Name:lower()
        end
        return a.ClassName < b.ClassName
    end)

    SysScanner.Remotes = remotesList
    local elapsedTime = math.floor((os.clock() - startTime) * 1000) / 1000

    print(string.format("[SysScanner] Pemindaian remote selesai dalam %.3f detik. Ditemukan: %d remote.", elapsedTime, #remotesList))
    return remotesList, elapsedTime
end

function SysScanner.StartWatcher(onNewRemoteCallback)
    if SysScanner.IsWatching then return end
    SysScanner.IsWatching = true

    local function hookContainer(container)
        if not container then return end
        local ok, conn = pcall(function()
            return container.DescendantAdded:Connect(function(descendant)
                task.wait(0.05)
                if SysScanner.IsRemote(descendant) then
                    local data = SysScanner.FormatRemoteData(descendant)
                    table.insert(SysScanner.Remotes, data)
                    print(string.format("[SysScanner Live] Remote Baru: %s (%s)", data.Name, data.ClassName))
                    if onNewRemoteCallback then
                        pcall(onNewRemoteCallback, data)
                    end
                end
            end)
        end)
        if ok and conn then
            table.insert(SysScanner.Connections, conn)
        end
    end

    for _, srvName in ipairs(SERVICES_TO_SCAN) do
        local ok, srv = pcall(function() return game:GetService(srvName) end)
        if ok and srv then hookContainer(srv) end
    end

    print("[SysScanner] Live Watcher diaktifkan.")
end

function SysScanner.StopWatcher()
    for _, conn in ipairs(SysScanner.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    SysScanner.Connections = {}
    SysScanner.IsWatching = false
    print("[SysScanner] Live Watcher dimatikan.")
end

-- ==============================================================================
-- [3] REMOTESPY ENGINE (Dual Hooking: __namecall + hookfunction)
-- ==============================================================================

local SPAM_REMOTES = {
    ["CharacterSoundEvent"] = true
}

local MAX_SPY_LOGS = 150
local rawOldNamecall = nil
local isLoggingCall = false
local recentCalls = {}

local function handleInterceptedCall(self, method, args)
    if not self or isLoggingCall then return end
    isLoggingCall = true

    local okRem, isRem = pcall(function() return SysScanner.IsRemote(self) end)
    if not okRem or not isRem then
        isLoggingCall = false
        return
    end

    if SysScanner.FilterSpam and SPAM_REMOTES[self.Name] then
        isLoggingCall = false
        return
    end

    -- Debounce jika tertangkap bersamaan oleh namecall dan hookfunction
    local now = os.clock()
    if recentCalls[self] and (now - recentCalls[self]) < 0.015 then
        isLoggingCall = false
        return
    end
    recentCalls[self] = now

    local timestamp = os.date("%X")
    local generatedCode = generateCallCode(self, method, args)

    local previewList = {}
    for i = 1, math.min(#args, 3) do
        local s = toLuaString(args[i], 0)
        if #s > 25 then s = s:sub(1, 22) .. "..." end
        table.insert(previewList, s)
    end
    if #args > 3 then table.insert(previewList, "...") end
    local argPreview = "(" .. table.concat(previewList, ", ") .. ")"

    local logItem = {
        Id = #SysScanner.SpyLogs + 1,
        Instance = self,
        Name = self.Name,
        ClassName = self.ClassName,
        Method = method,
        Args = args,
        ArgPreview = argPreview,
        Time = timestamp,
        Code = generatedCode,
        Path = generateLuaPath(self)
    }

    table.insert(SysScanner.SpyLogs, 1, logItem)
    if #SysScanner.SpyLogs > MAX_SPY_LOGS then
        table.remove(SysScanner.SpyLogs)
    end

    print(string.format("[SysScanner Spy] [%s] %s:%s%s", timestamp, self.Name, method, argPreview))

    if SysScanner.OnSpyLog then
        pcall(SysScanner.OnSpyLog, logItem)
    end

    isLoggingCall = false
end

function SysScanner.StartSpy()
    if SysScanner.IsSpying then return true end

    -- 1. Hook __namecall (Mencegat Remote:FireServer(...) dan :InvokeServer(...))
    if hookmetamethod then
        local oldNamecall = nil
        local okHook, err = pcall(function()
            oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                local method = getnamecallmethod and getnamecallmethod() or ""
                local lMethod = method:lower()
                if lMethod == "fireserver" or lMethod == "invokeserver" or lMethod == "fire" or lMethod == "invoke" then
                    local args = { ... }
                    task.spawn(handleInterceptedCall, self, method, args)
                end
                return oldNamecall(self, ...)
            end))
            rawOldNamecall = oldNamecall
        end)
        if okHook and rawOldNamecall then
            SysScanner.IsSpying = true
            print("[SysScanner Spy] RemoteSpy aktif! (__namecall berhasil terpasang).")
            return true
        end
    end

    -- Fallback via getrawmetatable jika hookmetamethod tidak tersedia
    if not SysScanner.IsSpying and getrawmetatable and setreadonly then
        local okGm, err = pcall(function()
            local gm = getrawmetatable(game)
            setreadonly(gm, false)
            local orig = gm.__namecall
            gm.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod and getnamecallmethod() or ""
                local lMethod = method:lower()
                if lMethod == "fireserver" or lMethod == "invokeserver" or lMethod == "fire" or lMethod == "invoke" then
                    local args = { ... }
                    task.spawn(handleInterceptedCall, self, method, args)
                end
                return orig(self, ...)
            end)
            rawOldNamecall = orig
            setreadonly(gm, true)
        end)
        if okGm and rawOldNamecall then
            SysScanner.IsSpying = true
            print("[SysScanner Spy] RemoteSpy aktif! (getrawmetatable berhasil terpasang).")
            return true
        end
    end

    if not SysScanner.IsSpying then
        warn("[SysScanner Spy] Executor tidak mendukung hookmetamethod / getrawmetatable.")
        return false
    end
    return true
end

function SysScanner.StopSpy()
    SysScanner.IsSpying = false
    print("[SysScanner Spy] RemoteSpy dinonaktifkan.")
end

function SysScanner.ClearSpyLogs()
    SysScanner.SpyLogs = {}
    print("[SysScanner Spy] Riwayat log dibersihkan.")
end

function SysScanner.TestSpy()
    local testEvt = Instance.new("BindableEvent")
    testEvt.Name = "SysScanner_TestEvent"
    testEvt.Parent = game:GetService("ReplicatedStorage")
    testEvt:Fire("Halo dari SysScanner!", 100, { status = "Berhasil Terdeteksi" })
    task.delay(0.5, function()
        pcall(function() testEvt:Destroy() end)
    end)
    print("[SysScanner] Test Event telah dipicu! Periksa tab RemoteSpy.")
end

-- Export functions untuk RemoteSpy (Salin Semua / Simpan File Log)
function SysScanner.ExportSpyLogsToString(searchKey)
    local lines = {}
    local timeStamp = os.date("%Y-%m-%d %H:%M:%S")
    table.insert(lines, "--[[")
    table.insert(lines, "    ==========================================================")
    table.insert(lines, "          SYSSCANNER REMOTESPY - SEMUA PANGGILAN TERREKAM     ")
    table.insert(lines, "    Tanggal : " .. timeStamp)
    table.insert(lines, "    Game ID : " .. tostring(game.PlaceId))
    table.insert(lines, "    Total   : " .. tostring(#SysScanner.SpyLogs) .. " panggilan")
    table.insert(lines, "    ==========================================================")
    table.insert(lines, "--]]\n")

    local matched = {}
    searchKey = searchKey and searchKey:lower() or ""
    for _, logItem in ipairs(SysScanner.SpyLogs) do
        if searchKey == "" or logItem.Name:lower():find(searchKey, 1, true) or logItem.ArgPreview:lower():find(searchKey, 1, true) then
            table.insert(matched, logItem)
        end
    end

    if #matched == 0 then
        table.insert(lines, "-- [Belum ada panggilan remote yang terekam]")
        return table.concat(lines, "\n")
    end

    -- Format urutan dari yang paling awal dipanggil sampai yang paling baru
    for i = #matched, 1, -1 do
        local item = matched[i]
        table.insert(lines, string.format("-- [%d] [%s] %s (%s)", (#matched - i + 1), item.Time, item.Name, item.Method))
        table.insert(lines, item.Code)
        table.insert(lines, "")
    end

    return table.concat(lines, "\n")
end

function SysScanner.ExportSpyLogsToClipboard(searchKey)
    local content = SysScanner.ExportSpyLogsToString(searchKey)
    local ok = copyToClipboard(content)
    if ok then
        print("[SysScanner] Berhasil menyalin seluruh log RemoteSpy ke clipboard!")
    else
        warn("[SysScanner] Executor tidak mendukung setclipboard.")
    end
    return ok
end

function SysScanner.ExportSpyLogsToFile(filename, searchKey)
    filename = filename or "SysScanner_SpyLogs_" .. tostring(game.PlaceId) .. ".txt"
    local content = SysScanner.ExportSpyLogsToString(searchKey)
    local ok = saveToFile(filename, content)
    if ok then
        print("[SysScanner] Berhasil menyimpan file log RemoteSpy: " .. filename)
    else
        warn("[SysScanner] Gagal menyimpan file log.")
    end
    return ok
end

