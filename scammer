-- Export functions untuk Remote Scanner
function SysScanner.ExportToString(filterClass)
    local lines = {}
    local timeStamp = os.date("%Y-%m-%d %H:%M:%S")
    table.insert(lines, "==========================================================")
    table.insert(lines, "               SYSSCANNER - DAFTAR REMOTE ROBLOX          ")
