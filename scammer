        pcall(function()
            SysScanner.Scan()
            refreshRemoteDisplay()
        end)
        task.spawn(function()
            pcall(function()
                SysScanner.ScanGameData()
                refreshDataDisplay()
            end)
        end)
        pcall(function()
            SysScanner.StartSpy()
        end)
    end)

    return ScreenGui
end

