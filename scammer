    refreshRemoteDisplay = function()
        for _, child in ipairs(ScrollList:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        local searchKeyword = SearchBox.Text:lower()
        local matched = {}

        for _, r in ipairs(SysScanner.Remotes) do
            local passClass = (currentFilter == "All") or (r.ClassName == currentFilter)
            if currentFilter == "Bindable" and (r.ClassName == "BindableEvent" or r.ClassName == "BindableFunction") then
                passClass = true
            end

            if passClass then
                if searchKeyword == "" or r.Name:lower():find(searchKeyword, 1, true) or r.FullName:lower():find(searchKeyword, 1, true) then
                    table.insert(matched, r)
                end
            end
        end

        for i, remoteData in ipairs(matched) do
            local item = renderRemoteItem(remoteData, i)
            item.Parent = ScrollList
        end

        ScrollList.CanvasSize = UDim2.new(0, 0, 0, #matched * 52)
        StatusLabel.Text = string.format("Total: %d | Ditampilkan: %d remote", #SysScanner.Remotes, #matched)
    end

    for i, tabInfo in ipairs(tabs) do
        local btn = Instance.new("TextButton")
        btn.Name = "Tab_" .. tabInfo.Id
        btn.Size = UDim2.new(0, 0, 1, 0)
        btn.AutomaticSize = Enum.AutomaticSize.X
        btn.BackgroundColor3 = (tabInfo.Id == currentFilter) and Color3.fromRGB(37, 99, 235) or Color3.fromRGB(26, 30, 42)
        btn.Text = "  " .. tabInfo.Label .. "  "
        btn.TextColor3 = Color3.fromRGB(240, 245, 255)
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamMedium
        btn.BorderSizePixel = 0
        btn.LayoutOrder = i
        btn.Parent = FilterBar

        local tabCorner = Instance.new("UICorner")
        tabCorner.CornerRadius = UDim.new(0, 5)
        tabCorner.Parent = btn

        filterButtons[tabInfo.Id] = btn

        btn.MouseButton1Click:Connect(function()
            currentFilter = tabInfo.Id
            for id, b in pairs(filterButtons) do
                b.BackgroundColor3 = (id == currentFilter) and Color3.fromRGB(37, 99, 235) or Color3.fromRGB(26, 30, 42)
            end
            refreshRemoteDisplay()
        end)
    end

