    refreshDataDisplay = function()
        for _, child in ipairs(DataScrollList:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        local searchKey = DataSearchBox.Text:lower()
        local matched = {}

        for _, item in ipairs(SysScanner.GameData) do
            local passCat = (currentDataFilter == "All") or (item.Category == currentDataFilter)
            if currentDataFilter == "Player" and (item.Category == "PlayerScripts" or item.Category == "Player") then
                passCat = true
            elseif currentDataFilter == "ReplicatedStorage" and (item.Category == "Features" or item.Category == "Content" or item.Category == "Modules" or item.Category == "ReplicatedStorage") then
                passCat = true
            end
            if passCat then
                if searchKey == "" or item.Name:lower():find(searchKey, 1, true) or tostring(item.Value):lower():find(searchKey, 1, true) or item.Source:lower():find(searchKey, 1, true) then
                    table.insert(matched, item)
                end
            end
        end

        local maxRender = 120
        local renderCount = math.min(#matched, maxRender)
        for i = 1, renderCount do
            local row = renderDataItem(matched[i], i)
            row.Parent = DataScrollList
        end

        DataScrollList.CanvasSize = UDim2.new(0, 0, 0, renderCount * 56)
        if #matched > maxRender then
            DataStatusLabel.Text = string.format("Total Data: %d | Ditampilkan: %d dari %d entri (Gunakan Search untuk menyaring)", #SysScanner.GameData, renderCount, #matched)
        else
            DataStatusLabel.Text = string.format("Total Data: %d | Ditampilkan: %d entri", #SysScanner.GameData, #matched)
        end
    end

