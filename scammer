local function safeGetParentGui()
    local targetParent = nil
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then targetParent = h end
    end
    if not targetParent then
        local ok, cg = pcall(function() return CoreGui end)
        if ok and cg and not RunService:IsStudio() then
            targetParent = cg
        end
    end
    if not targetParent and LocalPlayer then
        local ok, pg = pcall(function() return LocalPlayer:WaitForChild("PlayerGui", 5) end)
        if ok and pg then targetParent = pg end
    end
    return targetParent or game:GetService("StarterGui")
end

local function copyToClipboard(text)
    local copied = false
    if setclipboard then
        pcall(setclipboard, text)
        copied = true
    elseif syn and typeof(syn) == "table" and syn.write_clipboard then
        pcall(syn.write_clipboard, text)
        copied = true
    end
    return copied
end

local function saveToFile(filename, content)
    local saved = false
    if writefile then
        local ok = pcall(writefile, filename, content)
        saved = ok
    end
    return saved
end

-- Menghasilkan path Lua yang rapi dengan dot-notation jika nama valid
local function generateLuaPath(instance)
    if not instance or not instance.Parent then return "nil" end
    
    local pathParts = {}
    local current = instance
    local rootService = nil
    
    while current and current ~= game do
        if current.Parent == game then
            rootService = current.ClassName
            break
        else
            table.insert(pathParts, 1, current.Name)
            current = current.Parent
        end
    end
    
    if rootService then
        local pathStr = 'game:GetService("' .. rootService .. '")'
        for _, part in ipairs(pathParts) do
            if part:match("^[%a_][%w_]*$") and not part:match("^%d") then
                pathStr = pathStr .. "." .. part
            else
                pathStr = pathStr .. '["' .. part:gsub('"', '\\"') .. '"]'
            end
        end
        return pathStr
    end
    
    return instance:GetFullName()
end

-- Serializer nilai ke representasi string Luau yang valid
local function toLuaString(v, depth)
    depth = depth or 0
    local t = typeof(v)
    local indentStr = string.rep("    ", depth)
    local nextIndentStr = string.rep("    ", depth + 1)
    
    if t == "string" then
        return string.format("%q", v)
    elseif t == "number" or t == "boolean" then
        return tostring(v)
    elseif v == nil then
        return "nil"
    elseif t == "Instance" then
        return generateLuaPath(v)
    elseif t == "Vector3" then
        return string.format("Vector3.new(%s, %s, %s)", tostring(v.X), tostring(v.Y), tostring(v.Z))
    elseif t == "Vector2" then
        return string.format("Vector2.new(%s, %s)", tostring(v.X), tostring(v.Y))
    elseif t == "CFrame" then
        return string.format("CFrame.new(%s)", tostring(v))
    elseif t == "Color3" then
        return string.format("Color3.fromRGB(%d, %d, %d)", math.floor(v.R * 255), math.floor(v.G * 255), math.floor(v.B * 255))
    elseif t == "UDim2" then
        return string.format("UDim2.new(%s, %s, %s, %s)", tostring(v.X.Scale), tostring(v.X.Offset), tostring(v.Y.Scale), tostring(v.Y.Offset))
    elseif t == "UDim" then
        return string.format("UDim.new(%s, %s)", tostring(v.Scale), tostring(v.Offset))
    elseif t == "BrickColor" then
        return string.format("BrickColor.new(%q)", v.Name)
    elseif t == "EnumItem" then
        return tostring(v)
    elseif t == "table" then
        if depth > 4 then return "{ ... }" end
        
        local parts = {}
        local isArray = true
        local count = 0
        for k, _ in pairs(v) do
            count = count + 1
            if type(k) ~= "number" or k ~= count then
                isArray = false
            end
        end
        
        if count == 0 then return "{}" end
        
        if isArray then
            for _, val in ipairs(v) do
                table.insert(parts, nextIndentStr .. toLuaString(val, depth + 1))
            end
        else
            for key, val in pairs(v) do
                local keyStr
                if type(key) == "string" and key:match("^[%a_][%w_]*$") then
                    keyStr = key
                else
                    keyStr = "[" .. toLuaString(key, depth + 1) .. "]"
                end
                table.insert(parts, nextIndentStr .. keyStr .. " = " .. toLuaString(val, depth + 1))
            end
        end
        return "{\n" .. table.concat(parts, ",\n") .. "\n" .. indentStr .. "}"
    else
        return tostring(v)
    end
end

-- Menghasilkan potongan kode Luau lengkap seperti permintaan user
local function generateCallCode(remoteInst, method, args)
    local isFunc = remoteInst and remoteInst:IsA("RemoteFunction")
    local varName = isFunc and "Function" or "Event"
    local pathCode = generateLuaPath(remoteInst)
    
    local argStrings = {}
    for _, arg in ipairs(args or {}) do
        local formatted = toLuaString(arg, 1)
        table.insert(argStrings, "    " .. formatted:gsub("\n", "\n    "))
    end
    
    local argBody = ""
    if #argStrings > 0 then
        argBody = "\n" .. table.concat(argStrings, ",\n") .. "\n"
    end
    
    if isFunc then
        return string.format(
            'local %s = %s\nlocal Response = %s:%s(%s)',
            varName, pathCode, varName, method, argBody
        )
    else
        return string.format(
            'local %s = %s\n%s:%s(%s)',
            varName, pathCode, varName, method, argBody
        )
    end
end

SysScanner.GenerateCode = generateCallCode
